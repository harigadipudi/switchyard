        "widget": {
          "title": "W3C-Correlated Turn, Subagent & Cloud Trace Audit Explorer (apigee-ai-finops)",
          "logsPanel": {
            "filter": "logName=\"projects/@GCP_PROJECT_ID@/logs/apigee-ai-finops\" AND jsonPayload.event_type=\"ai_router_finops_turn\"",
            "resourceNames": [
