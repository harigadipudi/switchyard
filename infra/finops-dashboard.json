                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "3. Actual Billed Spend ($ After Credits)",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum(sum_over_time(logging_googleapis_com:user_ai_router_net_cash_usd_sum{monitored_resource=\"global\"}[${__interval}]))",
                  "unitOverride": "USD"
