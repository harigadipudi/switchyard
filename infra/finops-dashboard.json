          "xyChart": {
            "dataSets": [
              {
                "plotType": "STACKED_BAR",
                "minAlignmentPeriod": "60s",
                "legendTemplate": "Cached Context Reads (0.1x) — ${metric.project_name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "round(sum by (project_name) (sum_over_time(logging_googleapis_com:user_ai_router_cached_tokens_sum{monitored_resource=\"global\"}[${__interval}])))"
                }
