                  "prometheusQuery": "clamp_min(round(sum by (project_name) (sum_over_time(logging_googleapis_com:user_ai_router_total_tokens_sum{monitored_resource=\"global\"}[${__interval}]))) - round(sum by (project_name) (sum_over_time(logging_googleapis_com:user_ai_router_cached_tokens_sum{monitored_resource=\"global\"}[${__interval}]))), 0)"
